# 运行期主环境文件, 主配置打开后加载, 支持热加载.
# 启动级 pkgapp.default.env 不覆盖已有进程环境; 本文件覆盖同名进程变量.
# sys_conf.env_files 在本文件之后加载, 后加载的同名变量优先.

# 示例密钥, 不可用于真实服务. 缺失或解密为空时 pkg 拒绝启动.
# 新项目使用 pkg/tools 生成基础密钥, -appname 必须与 main.go 的 AppName 一致.
BASE_SECRET_KEY=8HZdybM3yafLSroHojd78J6mDnGPQTycHrUGEf5g8mm5

# 程序内部配置密文, 使用基础密钥和 xcrypto.Encrypt 生成.
# 可选备注只用于演示解密 env 热加载. status 只返回是否已配置, 不返回原文.
PKGAPP_NOTE=

# 对外接口的独立签名密钥, pkg 解密到 WebConf.SignKey. 演示原文: pkgapp-demo-sign-key.
WEB_SIGN_KEY=7bUkhoVVSirpWTjThpVZfC8Qk1r7NgJSHvuozo4zoLBN

# 对外 AES-GCM 密钥: crypto/rand 生成 32 字节, Raw URL Base64 后再用 Encrypt 包装.
# 这里也是公开的演示密文, 复制项目必须替换. 与签名密钥、基础密钥分开生成.
PKGAPP_PAYLOAD_KEY=2QsBRXMFnLKhv3F4vx4avC3oKnJnjWBjHLfpWhWxWPrFeYamrvHduBJzJE8x8Ab4gQ

# 非空时覆盖 app_conf.message. 同名变量会被 local.env 覆盖.
PKGAPP_MESSAGE=

# 仅 main_conf.secret_name 指向它时需要. 解密为空会拒绝启动.
# DATA_SOURCE_API_KEY=
