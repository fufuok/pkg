.PHONY: all test lint build clean dev help

SUB_DIR := src

all:
	cd ${SUB_DIR} && $(MAKE)

test:
	cd ${SUB_DIR} && $(MAKE) test

lint:
	cd ${SUB_DIR} && $(MAKE) lint

build:
	cd ${SUB_DIR} && $(MAKE) build

clean:
	cd ${SUB_DIR} && $(MAKE) clean

dev:
	cd ${SUB_DIR} && $(MAKE) dev

help:
	cd ${SUB_DIR} && $(MAKE) help
